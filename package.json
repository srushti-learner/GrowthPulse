{
  "name": "growthpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.0.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "exceljs": "^4.4.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "mysql2": "^3.15.3",
    "partial-json": "^0.1.7",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unzipper": "^0.12.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "readdir-glob@^3.0.0": {
      "minimatch": "^11.0.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
