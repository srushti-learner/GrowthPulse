NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
SQLITE_PATH=./data/growthpulse.sqlite
# Hosting: use NODE_ENV=production and your exact HTTPS APP_ORIGIN.
# Production defaults to MySQL; GoDaddy injects DB_HOST, DB_PORT, DB_NAME,
# DB_USER and DB_PASSWORD when its Hosted Database is attached. Do not copy
# local database files or override those locked settings.
# DATABASE_CLIENT=mysql
# DB_SSL_MODE=required
# DB_SSL_CA=<PEM CA certificate, only if supplied by your database provider>
# Disable TLS only if the provider explicitly requires a trusted private network.
# DB_SSL_MODE=disabled
# Leave proxy trust off until the hosting proxy topology is verified.
# TRUST_PROXY_HOPS=0
# Optional: enable the server-side business agent. Never use VITE_* for secrets.
# ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional competitor discovery through hosted Tavily MCP. Keep this secret local.
# TAVILY_API_KEY=your-key-here
